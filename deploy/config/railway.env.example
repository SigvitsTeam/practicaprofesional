RAILWAY_DOCKERFILE_PATH=deploy/docker/railway-demo.Dockerfile
NODE_ENV=production
PORT=3000
API_PREFIX=api
DATABASE_URL=REEMPLAZAR_CON_DATABASE_URL_DEL_BACKEND_CON_SSL
DATABASE_POOL_MAX=3
DATABASE_CONNECTION_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=10000
AUTH_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Completar solo en Railway o en el archivo local ignorado, nunca en este ejemplo.
AUTH_ADMIN_SECRET=
AUTH_INVITATION_REDIRECT_URL=https://FRONTEND.vercel.app/?auth=invite
METRICS_BEARER_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO_DE_AL_MENOS_32_CARACTERES
CORS_ORIGINS=https://FRONTEND.vercel.app
TRUST_PROXY_HOPS=1
EXPORT_STORAGE_DIRECTORY=/var/lib/sigvits/exports
EXPORT_WORKER_POLL_MS=10000
EXPORT_WORKER_HEALTH_HOST=127.0.0.1
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=15
