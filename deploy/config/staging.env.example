SIGVITS_ENVIRONMENT=staging
RELEASE_TAG=staging
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
API_PORT=3000
POSTGRES_PORT=5432
POSTGRES_DB=sigvits
POSTGRES_USER=sigvits_owner
POSTGIS_IMAGE_TAG=17-3.5-alpine
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
RUNTIME_DB_PASSWORD_FILE=./secrets/runtime_db_password.txt
DATABASE_URL_FILE=./secrets/database_url.txt
DIRECT_URL_FILE=./secrets/direct_url.txt
AUTH_ADMIN_SECRET_FILE=./secrets/auth_admin_secret.txt
METRICS_BEARER_TOKEN_FILE=./secrets/metrics_bearer_token.txt
AUTH_ISSUER=https://project-id.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://project-id.supabase.co/auth/v1/.well-known/jwks.json
AUTH_INVITATION_REDIRECT_URL=https://staging.example.org
CORS_ORIGINS=https://staging.example.org
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
SIGVITS_API_URL=https://api.staging.example.org/api
SIGVITS_API_ORIGIN=https://api.staging.example.org
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key

# En promoción, use referencias completas certificadas por digest:
# SIGVITS_API_IMAGE_REF=registry.example.org/sigvits-api@sha256:replace-with-digest
# SIGVITS_WORKER_IMAGE_REF=registry.example.org/sigvits-worker@sha256:replace-with-digest
# SIGVITS_MIGRATOR_IMAGE_REF=registry.example.org/sigvits-migrator@sha256:replace-with-digest
# SIGVITS_FRONTEND_IMAGE_REF=registry.example.org/sigvits-frontend@sha256:replace-with-digest
