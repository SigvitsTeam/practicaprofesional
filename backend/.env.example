NODE_ENV=development
PORT=3000
API_PREFIX=api
DATABASE_URL=postgresql://sigvits:change-me@localhost:5432/sigvits?schema=public
DIRECT_URL=postgresql://sigvits:change-me@localhost:5432/sigvits?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
AUTH_ISSUER=https://project-id.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://project-id.supabase.co/auth/v1/.well-known/jwks.json
AUTH_CLOCK_TOLERANCE_SECONDS=5
AUTH_JWKS_TIMEOUT_MS=5000
EXPORT_STORAGE_DIRECTORY=.data/exports
EXPORT_WORKER_POLL_MS=2000
EXPORT_JOB_STALE_MS=900000
EXPORT_ARTIFACT_TTL_MS=86400000
# Solo para ejecutar una vez `npm run db:bootstrap-admin`:
# BOOTSTRAP_ADMIN_ISSUER=https://project-id.supabase.co/auth/v1
# BOOTSTRAP_ADMIN_SUBJECT=00000000-0000-0000-0000-000000000000
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ADMIN_NAME=Administrador Inicial
# Para `npm run db:provision-user` después de crear la identidad en Supabase Auth:
# PROVISION_USER_SUBJECT=00000000-0000-0000-0000-000000000000
# PROVISION_USER_EMAIL=usuario@example.org
# PROVISION_USER_NAME=Nombre Completo
# PROVISION_USER_ROLE=RESPONSABLE_ESTABLECIMIENTO
# PROVISION_SCOPE_TYPE=ESTABLECIMIENTO
# PROVISION_SCOPE_CODE=85481
# PROVISION_ACTOR_EMAIL=admin@example.org
# Para `npm run db:set-period-status`:
# PERIOD_YEAR=2026
# PERIOD_MONTH=8
# PERIOD_STATUS=ABIERTO
# PERIOD_REASON=Apertura autorizada del período mensual.
# PERIOD_ACTOR_EMAIL=admin@example.org
CORS_ORIGINS=http://localhost:4200
REQUEST_BODY_LIMIT=100kb
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
TRUST_PROXY=false
